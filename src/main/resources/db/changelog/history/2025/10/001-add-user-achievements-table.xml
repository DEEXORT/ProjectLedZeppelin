<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="1759831803270-1" author="d.gimaldinov">
        <createTable tableName="user_achievements">
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="achievement_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="user_achievements" columnNames="user_id, achievement_id" constraintName="pk_user_achievements"/>

        <addForeignKeyConstraint baseTableName="user_achievements" baseColumnNames="achievement_id"
                                 constraintName="fk_achievements_id"
                                 referencedTableName="achievements"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="user_achievements" baseColumnNames="user_id" constraintName="fk_user_id"
                                 referencedTableName="users"
                                 referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>