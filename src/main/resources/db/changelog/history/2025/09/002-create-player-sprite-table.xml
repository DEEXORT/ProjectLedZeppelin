<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="1757959504383-1" author="d.gimaldinov">
        <createTable tableName="player-sprites">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints nullable="false"/>
            </column>
            <column name="sprite_url" type="varchar(255)"/>
            <column name="state" type="varchar(50)"/>
        </createTable>

        <createTable tableName="monster-sprites">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints nullable="false"/>
            </column>
            <column name="monster_type" type="varchar(50)"/>
            <column name="sprite_url" type="varchar(255)"/>
            <column name="state" type="varchar(50)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>