<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="1755942050219-1" author="d.gimaldinov">
        <createTable tableName="players">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="character_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="scene_id" type="bigint"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="players" baseColumnNames="character_id"
                                 constraintName="fk_players_character_id"
                                 referencedTableName="characters"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="players" baseColumnNames="user_id" constraintName="fk_players_user_id"
                                 referencedTableName="users"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="players" baseColumnNames="scene_id" constraintName="fk_players_scene_id"
                                 referencedTableName="scenes"
                                 referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>